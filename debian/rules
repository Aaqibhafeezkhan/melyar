#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export RUST_BACKTRACE = 1

%:
	dh $@

override_dh_auto_configure:
	cmake -B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr

override_dh_auto_build:
	# The web interface is committed to the repository, so pnpm is only needed
	# when it is available. When it is, the bundle is rebuilt so that the
	# package always ships the current interface.
	if command -v pnpm >/dev/null 2>&1; then \
		cd ui_web && pnpm install --frozen-lockfile && pnpm build && cd ..; \
	else \
		echo "pnpm not found, using the committed web interface bundle"; \
	fi
	cmake --build build -j$(nproc)

# The install is done here rather than through dh_auto_install, because the
# project is configured into build/ and debhelper does not pick that up.
override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/melyar cmake --install build

override_dh_auto_test:
	# The lyrics test reaches out to lrclib, so it is skipped here. The
	# continuous integration runs the full suite.
	cargo test --manifest-path core_rs/Cargo.toml -- --skip lrclib

override_dh_auto_clean:
	rm -rf build debian/melyar debian/.debhelper debian/files
